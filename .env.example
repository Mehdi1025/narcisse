# Copier vers `.env.local` et remplir (voir `.env.copy` si tu l’as déjà généré localement)

NEXT_PUBLIC_SITE_URL=https://narcisse-hazel.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Développement : mot de passe des comptes seed (≥ 12 caractères, non committer)
# DEMO_PASSWORD=

# Import provisoire admin (désactivé par défaut)
# DEMO_TOOLS=1
# NEXT_PUBLIC_DEMO_TOOLS=1

# Boutique — paiement (mode test d'abord)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Optionnel si Checkout côté client plus tard
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Livraison désactivée au lancement (NEXT_PUBLIC_SHOP_SHIPPING_ENABLED=1 pour activer)
# NEXT_PUBLIC_SHOP_SHIPPING_FLAT_CENTS=590

# Catalogue JSON provisoire si Supabase est en panne (désactivé — ne pas activer en production)
# SHOP_FALLBACK_CATALOGUE=1